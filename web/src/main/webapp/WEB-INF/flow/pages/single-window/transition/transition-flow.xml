<flow xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.springframework.org/schema/webflow"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      parent="pages/transition" abstract="true">
    <end-state id="menu-single-window-currency-exchange"/>
    <end-state id="menu-single-window-operation-log"/>
    <end-state id="menu-single-window-client-search"/>
    <end-state id="menu-single-window-transfer"/>
    <end-state id="menu-single-window-payments-woa"/>
    <global-transitions>
        <transition on="menu-single-window-currency-exchange" to="menu-single-window-currency-exchange"/>
        <transition on="menu-single-window-operation-log" to="menu-single-window-operation-log"/>
        <transition on="menu-single-window-client-search" to="menu-single-window-client-search"/>
        <transition on="menu-single-window-transfer" to="menu-single-window-transfer"/>
        <transition on="menu-single-window-payments-woa" to="menu-single-window-payments-woa"/>
    </global-transitions>
</flow>
