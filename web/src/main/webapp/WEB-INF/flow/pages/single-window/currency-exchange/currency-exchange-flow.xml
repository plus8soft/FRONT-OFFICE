<flow xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.springframework.org/schema/webflow"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      parent="pages/single-window/transition">
    <view-state id="step-one">
        <var name="stepOne" class="web.view.ce.currencyexchange.StepOne"/>
        <on-entry>
            <evaluate expression="stepOne.init(flowScope.FS_OPERATION)"/>
        </on-entry>
        <transition on="next" to="step-two">
            <set name="flowScope.FS_OPERATION" value="stepOne.operation"/>
        </transition>
    </view-state>
    <view-state id="step-two">
        <var name="stepTwo" class="web.view.ce.currencyexchange.StepTwo"/>
        <on-entry>
            <evaluate expression="stepTwo.init(flowScope.FS_OPERATION)"/>
        </on-entry>
        <transition on="next" to="step-four"/>
        <transition on="select-person" to="step-three"/>
        <transition on="repeat" to="step-one"/>
        <transition on="cancel" to="step-one">
            <set name="flowScope.FS_OPERATION" value="null"/>
        </transition>
    </view-state>
    <subflow-state id="step-three" subflow="pages/single-window/client-search">
        <input name="stepNumber" value="3"/>
        <input name="stepsCount" value="4"/>
        <input name="headerLabel" value="'Select Client'"/>
        <!--<input name="validators"
               value="T(java.util.Collections).singletonList(new web.service.crm.validator.PassportScanCopyValidator(flowScope.FS_OPERATION))"/>-->
        <output name="personIdOut" value="flowScope.FS_PERSON_ID"/>
        <transition on="back" to="step-two"/>
        <transition on="cancel" to="step-one">
            <set name="flowScope.FS_OPERATION" value="null"/>
        </transition>
        <transition on="next" to="step-four"/>
    </subflow-state>
    <view-state id="step-four">
        <var name="stepFour" class="web.view.ce.currencyexchange.StepFour"/>
        <on-entry>
            <evaluate expression="stepFour.init(flowScope.FS_OPERATION, flowScope.FS_PERSON_ID)"/>
        </on-entry>
        <transition on="cancel" to="step-one">
            <set name="flowScope.FS_OPERATION" value="null"/>
        </transition>
    </view-state>
</flow>
