<flow xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns="http://www.springframework.org/schema/webflow"
      xsi:schemaLocation="http://www.springframework.org/schema/webflow http://www.springframework.org/schema/webflow/spring-webflow.xsd"
      parent="pages/transition" start-state="start-task">
    <subflow-state id="menu-ce-currency" subflow="pages/ce/currency" parent="pages/transition#task"/>
    <subflow-state id="menu-ce-department-currency" subflow="pages/ce/department-currency" parent="pages/transition#task"/>
    <subflow-state id="menu-ce-rule" subflow="pages/ce/rule" parent="pages/transition#task"/>
    <subflow-state id="menu-ce-commission" subflow="pages/ce/commission" parent="pages/transition#task"/>
    <subflow-state id="menu-ce-convertion" subflow="pages/ce/conversion" parent="pages/transition#task"/>
    <subflow-state id="menu-ce-rate" subflow="pages/ce/rate" parent="pages/transition#task"/>
    <subflow-state id="menu-ce-order" subflow="pages/ce/order" parent="pages/transition#task"/>
    <global-transitions>
        <transition on="menu-ce-currency" to="menu-ce-currency"/>
        <transition on="menu-ce-department-currency" to="menu-ce-department-currency"/>
        <transition on="menu-ce-rule" to="menu-ce-rule"/>
        <transition on="menu-ce-commission" to="menu-ce-commission"/>
        <transition on="menu-ce-convertion" to="menu-ce-convertion"/>
        <transition on="menu-ce-rate" to="menu-ce-rate"/>
        <transition on="menu-ce-order" to="menu-ce-order"/>
    </global-transitions>
</flow>
