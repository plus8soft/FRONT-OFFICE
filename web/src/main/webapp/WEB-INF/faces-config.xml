<faces-config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.2"
              xmlns="http://xmlns.jcp.org/xml/ns/javaee"
              xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
    http://xmlns.jcp.org/xml/ns/javaee/web-facesconfig_2_2.xsd">
    <application>
        <el-resolver>org.springframework.web.jsf.el.SpringBeanFacesELResolver</el-resolver>
        <el-resolver>web.configuration.EmptyToNullStringElResolver</el-resolver>
        <resource-handler>web.configuration.VersionResourceHandler</resource-handler>
        <message-bundle>message.message</message-bundle>
    </application>
    <render-kit>
        <renderer>
            <component-family>org.primefaces.component</component-family>
            <renderer-type>org.primefaces.component.ImageCropperRenderer</renderer-type>
            <renderer-class>web.view.ce.clientedit.Base64CropperRenderer</renderer-class>
        </renderer>
        <renderer>
            <component-family>org.primefaces.component</component-family>
            <renderer-type>web.component.AutoCompleteRenderer</renderer-type>
            <renderer-class>web.component.AutoCompleteRenderer</renderer-class>
        </renderer>
    </render-kit>
    <component>
        <component-type>web.component.AutoComplete</component-type>
        <component-class>web.component.AutoComplete</component-class>
    </component>
</faces-config>
