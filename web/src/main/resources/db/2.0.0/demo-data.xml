        <sql>
            INSERT INTO DICT.COUNTERAGENT_PAY_ACTIONS (COUNTERAGENT_PAY_ACTIONS_ID, COUNTERAGENTS_ID, NAME, CASH_SYMBOL, ACCOUNT, VAT, MAIN, TYPE)
            SELECT NEXT VALUE FOR DICT.COUNTERAGENT_PAY_ACTIONS_ID_SEQ, c.COUNTERAGENTS_ID, 'Company payment', '01',
                   '40911000000000000000', 0, 1, 2
            FROM DICT.COUNTERAGENTS c WHERE c.EIN = '123456789';
        </sql>
        <sql>
            INSERT INTO DICT.IDENTIFICATION_RULES (IDENTIFICATION_RULES_ID, TASKS_ID, NAME, SYSTEM_NAME, MIN_VAL, MAX_VAL)
            SELECT NEXT VALUE FOR DICT.IDENTIFICATION_RULES_ID_SEQ, t.TASKS_ID, 'WOA payer identification', 'PAY_PERS_IDENT', 0, 999999999
            FROM CORE.TASKS t WHERE t.SYSTEM_NAME = 'menu-single-window-payments-woa';
        </sql>
