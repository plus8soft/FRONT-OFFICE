        </insert>
        <insert schemaName="DICT" tableName="ACCOUNTS">
            <column name="ACCOUNT" value="40911000000000000000"/>
            <column name="CURRENCY" value="USD"/>
            <column name="DEPARTMENTS_ID" valueNumeric="1"/>
            <column name="NAME" value="Demo WOA settlement account"/>
            <column name="STATUS" valueBoolean="true"/>
        </insert>
        <insert schemaName="DICT" tableName="PAY_ACTIONS">
