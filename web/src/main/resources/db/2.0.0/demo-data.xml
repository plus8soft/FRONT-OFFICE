        </insert>
        <insert schemaName="DICT" tableName="PAY_ACTIONS">
            <column name="PAY_ACTIONS_ID" valueComputed="NEXT VALUE FOR DICT.PAY_ACTIONS_ID_SEQ"/>
            <column name="NAME" value="Public sector payment"/>
            <column name="CASH_SYMBOL" value="02"/>
            <column name="DISABLED" valueBoolean="false"/>
            <column name="TYPE" valueNumeric="0"/>
        </insert>
        <insert schemaName="DICT" tableName="PAY_ACTIONS">
            <column name="PAY_ACTIONS_ID" valueComputed="NEXT VALUE FOR DICT.PAY_ACTIONS_ID_SEQ"/>
            <column name="NAME" value="Tax payment"/>
            <column name="CASH_SYMBOL" value="03"/>
            <column name="DISABLED" valueBoolean="false"/>
            <column name="TYPE" valueNumeric="1"/>
        </insert>
        <insert schemaName="DICT" tableName="COUNTERAGENTS">
            <column name="COUNTERAGENTS_ID" valueComputed="NEXT VALUE FOR DICT.COUNTERAGENTS_ID_SEQ"/>
            <column name="EIN" value="123456789"/>
            <column name="NAME" value="Demo Services LLC"/>
            <column name="ADDRESS" value="200 Business Rd, New York, NY"/>
            <column name="BANK_ROUTING_NUMBER" value="021000021"/>
