<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <changeSet id="demo-regions-table" author="2.0.0-demo" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="DICT" tableName="REGIONS"/></not>
        </preConditions>
        <comment>Regions table for Transfer payment points</comment>
        <createTable schemaName="DICT" tableName="REGIONS" remarks="Regions">
            <column name="REGIONS_ID" type="INT" remarks="Region ID">
                <constraints nullable="false" primaryKey="true" primaryKeyName="REGIONS_ID_PK"/>
            </column>
            <column name="COUNTRIES_ISO" type="VARCHAR(10)" remarks="Country ISO">
                <constraints nullable="false" foreignKeyName="REGIONS_COUNTRIES_ISO_FK" references="DICT.COUNTRIES(COUNTRIES_ISO)"/>
            </column>
            <column name="NAME" type="VARCHAR(200)" remarks="Name">
                <constraints nullable="false"/>
            </column>
            <column name="CODE" type="VARCHAR(50)" remarks="Code"/>
            <column name="ENABLE" type="BIT" defaultValueBoolean="true" remarks="Enabled">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createSequence schemaName="DICT" sequenceName="REGIONS_ID_SEQ" startValue="1" incrementBy="20"/>
    </changeSet>

    <changeSet id="demo-pay-actions-table" author="2.0.0-demo" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="DICT" tableName="PAY_ACTIONS"/></not>
        </preConditions>
        <createTable schemaName="DICT" tableName="PAY_ACTIONS" remarks="Payment action types">
            <column name="PAY_ACTIONS_ID" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PAY_ACTIONS_ID_PK"/>
            </column>
            <column name="NAME" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>
            <column name="CASH_SYMBOL" type="VARCHAR(50)"/>
            <column name="DISABLED" type="BIT" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="TYPE" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createSequence schemaName="DICT" sequenceName="PAY_ACTIONS_ID_SEQ" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="demo-counteragents-table" author="2.0.0-demo" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="DICT" tableName="COUNTERAGENTS"/></not>
        </preConditions>
        <createTable schemaName="DICT" tableName="COUNTERAGENTS" remarks="WOA counteragents">
            <column name="COUNTERAGENTS_ID" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="COUNTERAGENTS_ID_PK"/>
            </column>
            <column name="USERS_ID" type="INT">
                <constraints foreignKeyName="COUNTERAGENTS_USERS_ID_FK" references="CORE.USERS(USERS_ID)"/>
            </column>
            <column name="CDATE" type="DATETIME2"/>
            <column name="VERSION" type="BIGINT"/>
            <column name="EIN" type="VARCHAR(20)"/>
            <column name="NAME" type="VARCHAR(200)"/>
            <column name="ADDRESS" type="VARCHAR(500)"/>
            <column name="BANK_ROUTING_NUMBER" type="VARCHAR(9)"/>
            <column name="CONTRACT" type="BIT" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="DISABLED" type="BIT" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="PURPOSE_TEMPLATE" type="VARCHAR(2000)"/>
        </createTable>
        <createSequence schemaName="DICT" sequenceName="COUNTERAGENTS_ID_SEQ" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="demo-counteragent-pay-actions-table" author="2.0.0-demo" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="DICT" tableName="COUNTERAGENT_PAY_ACTIONS"/></not>
        </preConditions>
        <createTable schemaName="DICT" tableName="COUNTERAGENT_PAY_ACTIONS" remarks="Counteragent payment actions">
            <column name="COUNTERAGENT_PAY_ACTIONS_ID" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="COUNTERAGENT_PAY_ACTIONS_ID_PK"/>
            </column>
            <column name="COUNTERAGENTS_ID" type="INT">
                <constraints nullable="false" foreignKeyName="COUNTERAGENT_PAY_ACTIONS_COUNTERAGENTS_ID_FK"
                             references="DICT.COUNTERAGENTS(COUNTERAGENTS_ID)"/>
            </column>
            <column name="NAME" type="VARCHAR(200)"/>
            <column name="CASH_SYMBOL" type="VARCHAR(50)"/>
            <column name="ACCOUNT" type="VARCHAR(50)">
                <constraints foreignKeyName="COUNTERAGENT_PAY_ACTIONS_ACCOUNT_FK" references="DICT.ACCOUNTS(ACCOUNT)"/>
            </column>
            <column name="VAT" type="INT"/>
            <column name="MAIN" type="BIT"/>
            <column name="TYPE" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createSequence schemaName="DICT" sequenceName="COUNTERAGENT_PAY_ACTIONS_ID_SEQ" startValue="1" incrementBy="1"/>
    </changeSet>

    <changeSet id="demo-identification-rules-table" author="2.0.0-demo" failOnError="true">
        <preConditions onFail="MARK_RAN">
            <not><tableExists schemaName="DICT" tableName="IDENTIFICATION_RULES"/></not>
        </preConditions>
        <createTable schemaName="DICT" tableName="IDENTIFICATION_RULES" remarks="Identification amount rules">
            <column name="IDENTIFICATION_RULES_ID" type="INT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="IDENTIFICATION_RULES_ID_PK"/>
            </column>
            <column name="TASKS_ID" type="INT">
                <constraints foreignKeyName="IDENTIFICATION_RULES_TASKS_ID_FK" references="CORE.TASKS(TASKS_ID)"/>
            </column>
            <column name="NAME" type="VARCHAR(200)"/>
            <column name="SYSTEM_NAME" type="VARCHAR(100)"/>
            <column name="MIN_VAL" type="DECIMAL(18,2)"/>
            <column name="MAX_VAL" type="DECIMAL(18,2)"/>
        </createTable>
        <createSequence schemaName="DICT" sequenceName="IDENTIFICATION_RULES_ID_SEQ" startValue="1" incrementBy="1"/>
    </changeSet>

