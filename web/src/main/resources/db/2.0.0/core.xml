                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="1" author="2.0.0" failOnError="true">
        <sql>CREATE SCHEMA CORE</sql>
        <createView viewName="TABLE_DESCRIPTIONS_V" schemaName="CORE"><![CDATA[
            SELECT
                schemas.name                                  schemaName,
                tables.name                                   tableName,
                CAST(extended_properties.value AS VARCHAR) AS tableDescr
            FROM
                sys.tables
                INNER JOIN sys.schemas ON tables.schema_id = schemas.schema_id AND schemas.name NOT IN ('dbo', 'sys')
                LEFT JOIN sys.extended_properties ON
                                                    tables.object_id = extended_properties.major_id
                                                    AND extended_properties.minor_id = 0
                                                    AND extended_properties.name = 'MS_Description'
        ]]></createView>
        <createView viewName="TABLE_FIELDS_V" schemaName="CORE"><![CDATA[
            SELECT
              schemas.name                                  schemaName,
              tables.name                                   tableName,
              columns.name                                  columnName,
              UPPER(types.name)                             columnType,
              columns.max_length,
              columns.precision,
              CAST(extended_properties.value AS VARCHAR) AS columnDescr
            FROM
              sys.tables
              INNER JOIN sys.columns ON tables.object_id = columns.object_id
              INNER JOIN sys.schemas ON tables.schema_id = schemas.schema_id AND schemas.name NOT IN ('dbo', 'sys')
              INNER JOIN sys.types ON columns.user_type_id = types.user_type_id
              LEFT JOIN sys.extended_properties ON
                                                  tables.object_id = extended_properties.major_id
                                                  AND columns.column_id = extended_properties.minor_id
                                                  AND extended_properties.name IN ('MS_Description', 'ColumnDescription')
        ]]></createView>
        
