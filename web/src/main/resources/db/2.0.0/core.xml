        <!-- Job Position 2: Manager -->
        <insert schemaName="CORE" tableName="DICTIONARY_VALUES">
            <column name="DICTIONARY_VALUES_ID" valueComputed="NEXT VALUE FOR CORE.DICTIONARY_VALUES_ID_SEQ"/>
            <column name="DICT_NAME" value="USR_JOB_POSITION"/>
            <column name="CODE" value="2"/>
            <column name="VALUE" value="Manager"/>
