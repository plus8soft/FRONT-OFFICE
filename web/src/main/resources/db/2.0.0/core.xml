            <column name="GROUP_NAME" value="Administration Subsystem"/>
            <column name="UPD_DATE" valueComputed="GETUTCDATE()"/>
            <column name="IS_SYSTEM" valueBoolean="false"/>
            <column name="DESCRIPTION" value="Position"/>
