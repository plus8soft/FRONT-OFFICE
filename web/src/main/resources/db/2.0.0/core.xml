        <!-- Insert Time Zone values (2 American time zones) -->
        <!-- Time Zone 1: Eastern Time -->
        <insert schemaName="CORE" tableName="DICTIONARY_VALUES">
            <column name="DICTIONARY_VALUES_ID" valueComputed="NEXT VALUE FOR CORE.DICTIONARY_VALUES_ID_SEQ"/>
            <column name="DICT_NAME" value="TIME_ZONE"/>
            <column name="CODE" value="America/New_York"/>
            <column name="VALUE" value="Eastern Time EST/EDT (UTC-5/-4)"/>
            <column name="SHORT_VALUE" value="EST/EDT"/>
            <column name="IS_SYSTEM" valueBoolean="false"/>
            <column name="NOT_USE" valueBoolean="false"/>
        </insert>
        
        <!-- Time Zone 2: Pacific Time -->
        <insert schemaName="CORE" tableName="DICTIONARY_VALUES">
            <column name="DICTIONARY_VALUES_ID" valueComputed="NEXT VALUE FOR CORE.DICTIONARY_VALUES_ID_SEQ"/>
            <column name="DICT_NAME" value="TIME_ZONE"/>
            <column name="CODE" value="America/Los_Angeles"/>
            <column name="VALUE" value="Pacific Time PST/PDT (UTC-8/-7)"/>
            <column name="SHORT_VALUE" value="PST/PDT"/>
            <column name="IS_SYSTEM" valueBoolean="false"/>
            <column name="NOT_USE" valueBoolean="false"/>
        </insert>
        
        <!-- Insert Job Position values (2 positions) -->
        <!-- Job Position 1: Administrator -->
        <insert schemaName="CORE" tableName="DICTIONARY_VALUES">
            <column name="DICTIONARY_VALUES_ID" valueComputed="NEXT VALUE FOR CORE.DICTIONARY_VALUES_ID_SEQ"/>
            <column name="DICT_NAME" value="USR_JOB_POSITION"/>
            <column name="CODE" value="1"/>
            <column name="VALUE" value="Administrator"/>
            <column name="SHORT_VALUE" value="Admin"/>
            <column name="IS_SYSTEM" valueBoolean="false"/>
            <column name="NOT_USE" valueBoolean="false"/>
