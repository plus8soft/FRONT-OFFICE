        <!-- AUDIT_PARAMS table based on EventSetting entity -->
        <createTable schemaName="CORE" tableName="AUDIT_PARAMS" remarks="Audit Parameters">
            <column name="AUDIT_PARAMS_ID" type="INT" remarks="Audit parameter identifier">
                <constraints nullable="false" primaryKey="true" primaryKeyName="AUDIT_PARAMS_ID_PK"/>
