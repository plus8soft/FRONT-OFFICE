        <createSequence schemaName="CORE" sequenceName="DEPARTMENT_PS_SYSTEMS_PK_SEQ" startValue="1" incrementBy="1"/>
        <createIndex indexName="CORE_DEPARTMENT_PS_SYSTEMS_DEPARTMENTS_ID_IDX" schemaName="CORE" tableName="DEPARTMENT_PS_SYSTEMS">
            <column name="DEPARTMENTS_ID"/>
        </createIndex>
