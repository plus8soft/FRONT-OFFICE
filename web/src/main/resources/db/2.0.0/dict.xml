        <!-- PS_POINTS table based on PaymentPoint entity -->
        <createTable schemaName="DICT" tableName="PS_POINTS" remarks="Payment Points">
            <column name="POINTS_ID" type="INT" remarks="Point identifier">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PS_POINTS_POINTS_ID_PK"/>
            </column>
            <column name="SYSTEMS_NAME" type="VARCHAR(50)" remarks="System name">
                <constraints nullable="false" foreignKeyName="PS_POINTS_SYSTEMS_NAME_FK" references="DICT.PS_SYSTEMS(SYSTEMS_NAME)"/>
