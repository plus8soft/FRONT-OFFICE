        <!-- ADDRESS_ABBREVIATIONS table based on Abbreviation entity -->
        <!-- This table stores address object type abbreviations (State, City, Street, Avenue, etc.) -->
        <!-- Used by AddressAutoComplete component for dropdown lists of address types -->
        <!-- Note: This is different from CRM.ADDRESS table which stores actual addresses -->
        <createTable schemaName="DICT" tableName="ADDRESS_ABBREVIATIONS" remarks="Address object type abbreviations">
            <column name="LEVEL" type="VARCHAR(20)" remarks="Object level of this type (REGION, DISTRICT, CITY, LOCALITY, STREET)">
                <constraints nullable="false"/>
            </column>
            <column name="SCNAME" type="VARCHAR(10)" remarks="Short name of object type (e.g., 'St', 'Ave', 'State')">
                <constraints nullable="false"/>
            </column>
            <column name="SOCRNAME" type="VARCHAR(29)" remarks="Full name of object type (e.g., 'Street', 'Avenue', 'State')"/>
            <column name="KOD_T_ST" type="VARCHAR(3)" remarks="Object type code"/>
        </createTable>
        <addPrimaryKey schemaName="DICT" tableName="ADDRESS_ABBREVIATIONS" columnNames="LEVEL,SCNAME" constraintName="ADDRESS_ABBREVIATIONS_PK"/>
        
        <!-- One abbreviation per level so Region, District, City, Locality, Street dropdowns have data -->
        <insert schemaName="DICT" tableName="ADDRESS_ABBREVIATIONS">
            <column name="LEVEL" value="REGION"/>
            <column name="SCNAME" value="State"/>
            <column name="SOCRNAME" value="State"/>
        </insert>
        <insert schemaName="DICT" tableName="ADDRESS_ABBREVIATIONS">
            <column name="LEVEL" value="DISTRICT"/>
            <column name="SCNAME" value="Dist"/>
            <column name="SOCRNAME" value="District"/>
        </insert>
        <insert schemaName="DICT" tableName="ADDRESS_ABBREVIATIONS">
            <column name="LEVEL" value="CITY"/>
            <column name="SCNAME" value="City"/>
            <column name="SOCRNAME" value="City"/>
        </insert>
        <insert schemaName="DICT" tableName="ADDRESS_ABBREVIATIONS">
            <column name="LEVEL" value="LOCALITY"/>
            <column name="SCNAME" value="Loc"/>
            <column name="SOCRNAME" value="Locality"/>
        </insert>
        <insert schemaName="DICT" tableName="ADDRESS_ABBREVIATIONS">
            <column name="LEVEL" value="STREET"/>
            <column name="SCNAME" value="St"/>
            <column name="SOCRNAME" value="Street"/>
        </insert>
        
        <!-- ADDRESS_ELEMENTS table based on AbstractLeveledAddressElement entity -->
        <!-- This table stores address elements: regions, districts, cities, localities -->
        <!-- CODE format: REGION(2) + DISTRICT(3) + CITY(3) + LOCALITY(3) + ACTUALITY(2) = 13 chars (column VARCHAR(18) for longer codes) -->
        <createTable schemaName="DICT" tableName="ADDRESS_ELEMENTS" remarks="Address elements: regions, districts, localities">
            <column name="NAME" type="VARCHAR(40)" remarks="Name">
                <constraints nullable="false"/>
            </column>
            <column name="SOCR" type="VARCHAR(10)" remarks="Short name of object type"/>
            <column name="CODE" type="VARCHAR(18)" remarks="Code">
                <constraints nullable="false" primaryKey="true" primaryKeyName="ADDRESS_ELEMENTS_CODE_PK"/>
            </column>
            <column name="IND" type="VARCHAR(6)" remarks="Postal code"/>
            <column name="GNINMB" type="VARCHAR(4)" remarks="Tax office code"/>
            <column name="UNO" type="VARCHAR(4)" remarks="Tax office territorial unit code"/>
            <column name="OCATD" type="VARCHAR(11)" remarks="OKATO code"/>
            <column name="STATUS" type="VARCHAR(1)" remarks="Object status"/>
        </createTable>
        <sql><![CDATA[
            ALTER TABLE DICT.ADDRESS_ELEMENTS
              ADD REGION AS SUBSTRING(ADDRESS_ELEMENTS.CODE, 1, 2);
            
            ALTER TABLE DICT.ADDRESS_ELEMENTS
              ADD DISTRICT AS SUBSTRING(ADDRESS_ELEMENTS.CODE, 3, 3);
            
            ALTER TABLE DICT.ADDRESS_ELEMENTS
              ADD CITY AS SUBSTRING(ADDRESS_ELEMENTS.CODE, 6, 3);
            
            ALTER TABLE DICT.ADDRESS_ELEMENTS
              ADD LOCALITY AS SUBSTRING(ADDRESS_ELEMENTS.CODE, 9, 3);
            
            ALTER TABLE DICT.ADDRESS_ELEMENTS
              ADD ACTUALITY AS SUBSTRING(ADDRESS_ELEMENTS.CODE, 12, 2);
            
            ALTER TABLE DICT.ADDRESS_ELEMENTS
              ADD LEVEL AS (CASE
                            WHEN SUBSTRING(ADDRESS_ELEMENTS.CODE, 9, 3) != '000'
                              THEN 4
                            WHEN SUBSTRING(ADDRESS_ELEMENTS.CODE, 6, 3) != '000'
                              THEN 3
                            WHEN SUBSTRING(ADDRESS_ELEMENTS.CODE, 3, 3) != '000'
                              THEN 2
                            WHEN SUBSTRING(ADDRESS_ELEMENTS.CODE, 1, 2) != '00'
                              THEN 1 END);
        ]]></sql>
        <createIndex schemaName="DICT" tableName="ADDRESS_ELEMENTS" indexName="ADDRESS_ELEMENTS_LEVEL_ACTUALITY_IDX">
            <column name="LEVEL"/>
            <column name="ACTUALITY"/>
        </createIndex>
