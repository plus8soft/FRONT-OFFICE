<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">
    <changeSet id="1" author="2.0.0" failOnError="true">
        <sql>CREATE SCHEMA DICT</sql>
        
        <!-- COUNTRIES table based on Country entity -->
        <createTable schemaName="DICT" tableName="COUNTRIES" remarks="Countries">
            <column name="COUNTRIES_ISO" type="VARCHAR(10)" remarks="Country ISO code">
                <constraints nullable="false" primaryKey="true" primaryKeyName="COUNTRIES_ISO_PK"/>
            </column>
            <column name="NAME" type="VARCHAR(200)" remarks="Name">
                <constraints nullable="false"/>
            </column>
            <column name="ALPHA2" type="VARCHAR(2)" remarks="Alpha-2 code"/>
            <column name="ALPHA3" type="VARCHAR(3)" remarks="Alpha-3 code"/>
            <column name="ENABLE" type="BIT" remarks="Enabled">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- CURRENCIES table based on Currency entity -->
        <createTable schemaName="DICT" tableName="CURRENCIES" remarks="Currency Types">
            <column name="CURRENCIES_KD" type="VARCHAR(3)" remarks="Currency code">
                <constraints nullable="false" primaryKey="true" primaryKeyName="CURRENCIES_KD_PK"/>
            </column>
            <column name="ISO" type="VARCHAR(10)" remarks="ISO code">
                <constraints nullable="false"/>
            </column>
            <column name="NAME" type="VARCHAR(100)" remarks="Name">
                <constraints nullable="false"/>
            </column>
            <column name="RATIO" type="INT" remarks="Currency units per base currency">
                <constraints nullable="false"/>
            </column>
            <column name="GENDER" type="BIT" remarks="Gender">
                <constraints nullable="false"/>
            </column>
            <column name="INTEGRAL_VAL1" type="VARCHAR(100)" remarks="Integral (value 1)"/>
            <column name="INTEGRAL_VAL2" type="VARCHAR(100)" remarks="Integral (value 2)"/>
            <column name="INTEGRAL_VAL3" type="VARCHAR(100)" remarks="Integral (value 3)"/>
            <column name="FRACTIONAL_VAL1" type="VARCHAR(100)" remarks="Fractional (value 1)"/>
            <column name="FRACTIONAL_VAL2" type="VARCHAR(100)" remarks="Fractional (value 2)"/>
            <column name="FRACTIONAL_VAL3" type="VARCHAR(100)" remarks="Fractional (value 3)"/>
            <column name="IMG" type="VARBINARY(MAX)" remarks="Image"/>
            <column name="ENABLE" type="BIT" remarks="Usage flag" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="POSITION" type="INT" remarks="Display position">
                <constraints nullable="false"/>
            </column>
            <column name="ALTERNATIVE_KD" type="VARCHAR(3)" remarks="Alternative currency code">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint schemaName="DICT" tableName="CURRENCIES" columnNames="ALTERNATIVE_KD" constraintName="ALTERNATIVE_KD_UN"/>
        
        <!-- ACCOUNTS table based on Account entity -->
        <createTable schemaName="DICT" tableName="ACCOUNTS" remarks="Accounts">
            <column name="ACCOUNT" type="VARCHAR(50)" remarks="Account number">
                <constraints nullable="false" primaryKey="true" primaryKeyName="ACCOUNTS_ACCOUNT_PK"/>
            </column>
            <column name="CURRENCY" type="VARCHAR(3)" remarks="Currency code">
                <constraints nullable="false" foreignKeyName="ACCOUNTS_CURRENCY_FK" references="DICT.CURRENCIES(CURRENCIES_KD)"/>
            </column>
            <column name="DEPARTMENTS_ID" type="INT" remarks="Department ID">
                <constraints nullable="false" foreignKeyName="ACCOUNTS_DEPARTMENTS_ID_FK" references="CORE.DEPARTMENTS(DEPARTMENTS_ID)"/>
            </column>
            <column name="NAME" type="VARCHAR(200)" remarks="Name"/>
            <column name="STATUS" type="BIT" remarks="Status">
                <constraints nullable="false"/>
            </column>
        </createTable>
        
        <!-- ACCOUNT_LINKS table based on AccountLink entity -->
        <createTable schemaName="DICT" tableName="ACCOUNT_LINKS" remarks="Account Links">
            <column name="ACCOUNT_LINKS_ID" type="INT" remarks="Account link identifier">
                <constraints nullable="false" primaryKey="true" primaryKeyName="ACCOUNT_LINKS_ID_PK"/>
            </column>
            <column name="ACCOUNT" type="VARCHAR(50)" remarks="Account number">
                <constraints nullable="false" foreignKeyName="ACCOUNT_LINKS_ACCOUNT_FK" references="DICT.ACCOUNTS(ACCOUNT)"/>
            </column>
            <column name="DEPARTMENTS_ID" type="INT" remarks="Department ID">
                <constraints nullable="false" foreignKeyName="ACCOUNT_LINKS_DEPARTMENTS_ID_FK" references="CORE.DEPARTMENTS(DEPARTMENTS_ID)"/>
            </column>
            <column name="OBJ_TYPE" type="VARCHAR(20)" remarks="Object type"/>
            <column name="TYPE" type="VARCHAR(50)" remarks="Type"/>
            <column name="NIGHTLY" type="BIT" remarks="Nightly">
                <constraints nullable="false"/>
            </column>
            <column name="OPEN_DATE" type="DATETIME2" remarks="Open date"/>
            <column name="CLOSE_DATE" type="DATETIME2" remarks="Close date"/>
        </createTable>
        <createSequence schemaName="DICT" sequenceName="ACCOUNT_LINKS_ID_SEQ" startValue="1" incrementBy="1"/>
        
