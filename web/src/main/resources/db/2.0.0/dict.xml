                <constraints nullable="false" primaryKey="true" primaryKeyName="CORE_DEPARTMENT_PS_SYSTEMS_ID_PK"/>
            </column>
            <column name="DEPARTMENTS_ID" type="INT" remarks="Department ID">
                <constraints nullable="false" foreignKeyName="CORE_DEPARTMENT_PS_SYSTEMS_DEPARTMENTS_ID_FK"
                             references="CORE.DEPARTMENTS(DEPARTMENTS_ID)"/>
            </column>
            <column name="PS_SYSTEMS_NAME" type="VARCHAR(50)" remarks="Payment system system name">
