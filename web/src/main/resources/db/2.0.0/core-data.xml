        <!-- Assign specific tasks by SYSTEM_NAME (matching 1.0.0 configuration) -->
        <sql>
            <![CDATA[
            -- Assign tasks to admin (USERS_ID = 1) based on SYSTEM_NAME
            INSERT INTO CORE.USER_TASKS (USERS_ID, TASKS_ID)
            SELECT 1, TASKS_ID 
            FROM CORE.TASKS 
            WHERE SYSTEM_NAME IN (
                'menu-single-window-currency-exchange',
                'menu-ce-currency',
                'menu-ce-department-currency',
                'menu-ce-rule',
                'menu-ce-commission',
