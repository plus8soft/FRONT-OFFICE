        <!-- Assign rights to admin user (USERS_ID = 1) -->
        <sql>
            <![CDATA[
            -- Assign all rights to admin (USERS_ID = 1)
            INSERT INTO CORE.USER_RIGHTS (USERS_ID, RIGHTS_ID)
            SELECT 1, RIGHTS_ID 
            FROM CORE.RIGHTS;
            ]]>
        </sql>
        
        <!-- Create password history for admin -->
        <sql>
            <![CDATA[
            -- Create password history record for admin
            INSERT INTO CORE.USER_PASSWORDS (USER_PASSWORDS_ID, USERS_ID, CHANGE_DATE, PASS)
            SELECT 
                NEXT VALUE FOR CORE.USER_PASSWORDS_ID_SEQ,
                1,
                GETUTCDATE(),
                PASS
            FROM CORE.USERS
            WHERE USERS_ID = 1;
            
            -- Ensure PASS_CHANGE_ON_LOGIN is false and ACCOUNT_EXP_DATE is NULL (to prevent password change loop)
            UPDATE CORE.USERS
            SET PASS_CHANGE_ON_LOGIN = 0,
                ACCOUNT_EXP_DATE = NULL
            WHERE USERS_ID = 1;
            
            -- Update password history date to current date (to prevent expired password check)
            -- This ensures that even with PASS_EXP_TERM = 0, the expiration check passes
            UPDATE CORE.USER_PASSWORDS
            SET CHANGE_DATE = GETUTCDATE()
            WHERE USERS_ID = 1 
            AND USER_PASSWORDS_ID = (SELECT MAX(USER_PASSWORDS_ID) FROM CORE.USER_PASSWORDS WHERE USERS_ID = 1);
            ]]>
        </sql>
