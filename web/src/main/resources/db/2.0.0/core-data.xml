    <changeSet id="4" author="2.0.0" failOnError="true">
        <comment>Single Window menu tasks and admin grants</comment>
        <sql>
            <![CDATA[
            INSERT INTO CORE.TASKS (TASKS_ID, PROJECTS_ID, SYSTEM_NAME, NAME)
            SELECT NEXT VALUE FOR CORE.TASKS_ID_SEQ, p.PROJECTS_ID, 'menu-single-window-client-search', 'Client Search'
            FROM CORE.PROJECTS p
            WHERE p.SYSTEM_NAME = 'menu-single-window'
              AND NOT EXISTS (SELECT 1 FROM CORE.TASKS WHERE SYSTEM_NAME = 'menu-single-window-client-search');

            INSERT INTO CORE.TASKS (TASKS_ID, PROJECTS_ID, SYSTEM_NAME, NAME)
            SELECT NEXT VALUE FOR CORE.TASKS_ID_SEQ, p.PROJECTS_ID, 'menu-single-window-transfer', 'Transfers'
            FROM CORE.PROJECTS p
            WHERE p.SYSTEM_NAME = 'menu-single-window'
              AND NOT EXISTS (SELECT 1 FROM CORE.TASKS WHERE SYSTEM_NAME = 'menu-single-window-transfer');

            INSERT INTO CORE.TASKS (TASKS_ID, PROJECTS_ID, SYSTEM_NAME, NAME)
            SELECT NEXT VALUE FOR CORE.TASKS_ID_SEQ, p.PROJECTS_ID, 'menu-single-window-payments-woa', 'WOA Payments'
            FROM CORE.PROJECTS p
            WHERE p.SYSTEM_NAME = 'menu-single-window'
              AND NOT EXISTS (SELECT 1 FROM CORE.TASKS WHERE SYSTEM_NAME = 'menu-single-window-payments-woa');

            INSERT INTO CORE.TASKS (TASKS_ID, PROJECTS_ID, SYSTEM_NAME, NAME)
            SELECT NEXT VALUE FOR CORE.TASKS_ID_SEQ, p.PROJECTS_ID, 'menu-single-window-operation-log', 'Operation Log'
            FROM CORE.PROJECTS p
            WHERE p.SYSTEM_NAME = 'menu-single-window'
              AND NOT EXISTS (SELECT 1 FROM CORE.TASKS WHERE SYSTEM_NAME = 'menu-single-window-operation-log');

            INSERT INTO CORE.USER_TASKS (USERS_ID, TASKS_ID)
            SELECT 1, TASKS_ID
            FROM CORE.TASKS
            WHERE SYSTEM_NAME IN (
                'menu-single-window-client-search',
                'menu-single-window-transfer',
                'menu-single-window-payments-woa',
                'menu-single-window-operation-log'
            )
            AND NOT EXISTS (
                SELECT 1 FROM CORE.USER_TASKS ut
                WHERE ut.USERS_ID = 1 AND ut.TASKS_ID = TASKS.TASKS_ID
            );
            ]]>
        </sql>
    </changeSet>
